{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/word-count.mts\" --hook",
            "type": "command"
          },
          {
            "command": "git add -- $CLAUDE_FILE_PATHS 2>/dev/null; npx lint-staged",
            "statusMessage": "Linting the edited file",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  },
  "model": "opusplan"
}
