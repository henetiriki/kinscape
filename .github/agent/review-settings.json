{
  "permissions": {
    "allow": [
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh search:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)"
    ],
    "deny": [
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Monitor",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(//etc/**)",
      "Read(//home/runner/work/_temp/**)",
      "Read(~/.gitconfig)",
      "Read(~/.config/**)"
    ]
  }
}
