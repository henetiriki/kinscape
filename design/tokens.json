{
  "colour": {
    "brand": "#264f29",
    "brand-hover": "#1d3e20",
    "brand-pressed": "#163019",
    "brand-tint": "#e6eee4",
    "brand-tint-hover": "#d9e6d6",
    "brand-tint-pressed": "#ccddc8",
    "focus-ring": "{colour.brand}",
    "focus-ring-on-dark": "{colour.white}",
    "ink": "#18211b",
    "ink-2": "#2e3a33",
    "ink-3": "#4a544c",
    "ink-disabled": "#6e776f",
    "icon-disabled": "#a3aaa1",
    "field-border": "#8e978c",
    "line-strong": "#c9cfc5",
    "line": "#e2e5dd",
    "track": "#d6dad2",
    "segment": "#eef0ea",
    "surface-2": "#f4f5f0",
    "surface": "#ffffff",
    "white": "#ffffff",
    "scrim": "rgb(24 33 27 / 0.45)",
    "credits": "#24302b",
    "pin": "#9a3b12",
    "error": "#7e2316",
    "error-border": "#b4412f",
    "error-border-soft": "#e7b9b0",
    "error-bg": "#fbedea",
    "warning": "#6b4a00",
    "warning-border": "#b7791f",
    "warning-bg": "#fdf3dd",
    "success": "#1e5e32",
    "success-border": "#2f7d46",
    "success-bg": "#eaf4ec",
    "info": "#1e4e6b",
    "info-border": "#3e7fa6",
    "info-bg": "#e8f1f7",
    "google-text": "#1f1f1f",
    "google-border": "#747775",
    "google-mark": "#5f6368"
  },
  "shadow": {
    "raised": "0 1px 2px rgb(24 33 27 / 0.08), 0 6px 20px rgb(24 33 27 / 0.12)",
    "floating": "0 1px 2px rgb(24 33 27 / 0.1), 0 10px 30px rgb(24 33 27 / 0.2)",
    "modal": "0 10px 40px rgb(24 33 27 / 0.3)",
    "sheet": "0 -6px 24px rgb(24 33 27 / 0.16)",
    "segment": "0 1px 2px rgb(24 33 27 / 0.18)"
  },
  "font": {
    "display": "'Bricolage Grotesque', sans-serif",
    "body": "'Public Sans', system-ui, sans-serif",
    "mono": "'JetBrains Mono', monospace"
  },
  "type": {
    "display": {
      "font": "{font.display}",
      "size": "52px",
      "line": "56px",
      "weight": "700",
      "tracking": "-0.02em"
    },
    "h1": {
      "font": "{font.display}",
      "size": "32px",
      "line": "40px",
      "weight": "500",
      "tracking": "-0.015em"
    },
    "h2": {
      "font": "{font.display}",
      "size": "24px",
      "line": "32px",
      "weight": "700",
      "tracking": "0"
    },
    "h3": {
      "font": "{font.display}",
      "size": "22px",
      "line": "28px",
      "weight": "700",
      "tracking": "0"
    },
    "title": {
      "font": "{font.body}",
      "size": "15px",
      "line": "22px",
      "weight": "600",
      "tracking": "0"
    },
    "body-l": {
      "font": "{font.body}",
      "size": "16px",
      "line": "24px",
      "weight": "400",
      "tracking": "0"
    },
    "body": {
      "font": "{font.body}",
      "size": "15px",
      "line": "22px",
      "weight": "400",
      "tracking": "0"
    },
    "label": {
      "font": "{font.body}",
      "size": "14px",
      "line": "20px",
      "weight": "600",
      "tracking": "0"
    },
    "small": {
      "font": "{font.body}",
      "size": "13px",
      "line": "20px",
      "weight": "400",
      "tracking": "0"
    },
    "caption": {
      "font": "{font.body}",
      "size": "12.5px",
      "line": "18px",
      "weight": "400",
      "tracking": "0"
    },
    "credits": {
      "font": "{font.body}",
      "size": "11px",
      "line": "16px",
      "weight": "400",
      "tracking": "0"
    },
    "overline": {
      "font": "{font.body}",
      "size": "11px",
      "line": "16px",
      "weight": "600",
      "tracking": "0.1em"
    },
    "button": {
      "font": "{font.body}",
      "size": "16px",
      "line": "24px",
      "weight": "600",
      "tracking": "0"
    },
    "control": {
      "font": "{font.body}",
      "size": "15px",
      "line": "22px",
      "weight": "600",
      "tracking": "0"
    },
    "chip": {
      "font": "{font.body}",
      "size": "13.5px",
      "line": "20px",
      "weight": "600",
      "tracking": "0"
    },
    "button-s": {
      "font": "{font.body}",
      "size": "14px",
      "line": "20px",
      "weight": "600",
      "tracking": "0"
    },
    "mono-l": {
      "font": "{font.mono}",
      "size": "22px",
      "line": "28px",
      "weight": "500",
      "tracking": "0"
    },
    "mono": {
      "font": "{font.mono}",
      "size": "12px",
      "line": "16px",
      "weight": "400",
      "tracking": "0"
    }
  },
  "space": {
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "32": "32px",
    "40": "40px",
    "48": "48px",
    "64": "64px"
  },
  "radius": {
    "link": "2px",
    "small": "4px",
    "segment-item": "7px",
    "segment": "9px",
    "control": "8px",
    "panel": "12px",
    "sheet": "18px",
    "full": "999px"
  },
  "size": {
    "touch": "44px",
    "control": "44px",
    "control-l": "50px",
    "control-s": "40px",
    "control-xs": "36px",
    "field": "44px",
    "field-l": "48px",
    "search": "52px",
    "chip": "36px",
    "checkbox": "20px",
    "date-field": "188px",
    "panel": "320px",
    "gutter": "24px",
    "gutter-phone": "16px"
  },
  "focus": {
    "width": "2px",
    "offset": "2px"
  },
  "motion": {
    "press": "120ms ease-out",
    "popup": "160ms ease-out",
    "sheet": "240ms ease-out",
    "changed-border": "600ms ease-out",
    "toast": "4000ms"
  },
  "map": {
    "sea": "#c9d5d2",
    "land": "#e9ebe2",
    "coastline": { "colour": "#7e9a98", "width": 0.9 },
    "river": {
      "colour": "#6e99a3",
      "width-min": 1,
      "width-max": 3,
      "zoom-min": 3,
      "zoom-max": 8
    },
    "border": {
      "colour": "#3b3a2f",
      "width": 1.5,
      "dash-on": 4,
      "dash-off": 2.6
    },
    "district": { "colour": "#6f7263", "width": 0.8 },
    "changed": { "colour": "{colour.brand}", "width": 4 },
    "hatch": { "colour": "#8b4a1c", "opacity": 0.34 },
    "hillshade": {
      "shadow": "#5b6355",
      "highlight": "#ffffff",
      "mid": "#b9bdb0",
      "exaggeration": 0.3
    },
    "polity": {
      "default": "#dcd3bd",
      "eastern-cape": "#d9d3bc",
      "eswatini": "#cbd6da",
      "free-state": "#e3d2b2",
      "gauteng": "#d6ccba",
      "kwazulu-natal": "#dcd3bd",
      "lesotho": "#d9cfd9",
      "limpopo": "#d4d9c0",
      "mpumalanga": "#dad0b6",
      "north-west": "#d9cfba",
      "northern-cape": "#ddd6be",
      "western-cape": "#d3dcc4"
    },
    "polity-label": {
      "colour": "#2e2c22",
      "size": 12,
      "tracking": 0.15,
      "max-width": 6
    },
    "contested-label": { "colour": "#6b3412", "size": 11 },
    "place-label": { "colour": "{colour.ink}", "size": 12 },
    "place-dot": {
      "colour": "{colour.ink}",
      "radius": 3.4,
      "stroke": "{colour.white}",
      "stroke-width": 1.6
    },
    "water-label": { "colour": "#3f646c", "size": 13, "tracking": 0.2 },
    "river-label": { "colour": "{map.water-label.colour}", "size": 11 },
    "context-label": { "colour": "#56615a", "size": 11, "tracking": 0.12 },
    "muted-label": "#3f4a42",
    "label-halo": { "colour": "{map.land}", "width": 1.5 },
    "pin": {
      "colour": "{colour.pin}",
      "halo": "{colour.white}",
      "halo-width": 2,
      "fuzzy-opacity": 0.6
    },
    "pin-halo": { "colour": "{colour.pin}", "opacity": 0.24, "blur": 0.8 },
    "selected": { "colour": "{colour.brand}", "width": 2.5, "radius": 17 }
  }
}
