{
  "name": "kinscape",
  "private": true,
  "license": "MIT",
  "scripts": {
    "account:add": "node --env-file-if-exists=.env.local scripts/account-add.mts",
    "build": "next build",
    "check:production": "node scripts/check-production.mts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "design:check": "playwright test --project=design",
    "design:export": "node scripts/design-export.mts",
    "design:shots": "node scripts/design-shots.mts",
    "design-system": "node scripts/design-system.mts",
    "dev": "next dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "map:prepare": "node scripts/prepare-map-data.mts",
    "plan-approve": "node scripts/approve-plan.mts",
    "prepare": "husky",
    "review:threads": "node scripts/review-threads.mts",
    "start": "next start",
    "test": "vitest run --coverage",
    "tokens": "node scripts/tokens.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:boundaries": "node scripts/validate-boundaries.mts",
    "words": "node scripts/word-count.mts",
    "workflows:diagram": "node scripts/workflows-diagram.mts"
  },
  "imports": {
    "#ks/*": "./*"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/pg": "8.23.1",
    "kysely": "0.29.8",
    "maplibre-gl": "6.17.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "polylabel": "2.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/json": "2.1.1",
    "@maplibre/maplibre-gl-style-spec": "26.5.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/react": "16.3.3",
    "@turf/area": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/kinks": "7.4.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-package-json": "1.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "fontnik": "0.7.7",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "mapshaper": "0.7.101",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "react-18": "npm:react@18.3.1",
    "react-dom-18": "npm:react-dom@18.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "better-sqlite3": "13.0.3",
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "geographiclib": "npm:geographiclib-geodesic@2.2.0",
    "glob": "14.0.3",
    "react-dom-18": {
      "react": "$react"
    }
  },
  "allowScripts": {
    "better-sqlite3": false,
    "fsevents": false,
    "fontnik": false,
    "msgpackr-extract": false,
    "unrs-resolver": false
  }
}
