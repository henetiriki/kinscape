{
  "name": "kinscape",
  "private": true,
  "scripts": {
    "build": "next build",
    "design:check": "playwright test --project=design",
    "design:shots": "node scripts/design-shots.mts",
    "dev": "next dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "map:prepare": "node scripts/prepare-map-data.mts",
    "plan-approve": "node scripts/approve-plan.mts",
    "prepare": "husky",
    "start": "next start",
    "test": "vitest run --coverage",
    "tokens": "node scripts/tokens.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:boundaries": "node scripts/validate-boundaries.mts",
    "words": "node scripts/word-count.mts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "polylabel": "2.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/json": "2.1.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/react": "16.3.3",
    "@turf/area": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/kinks": "7.4.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-package-json": "1.10.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "fontnik": "0.7.7",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "mapshaper": "0.7.93",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "fontnik": false,
    "msgpackr-extract": false,
    "unrs-resolver": false
  }
}
